BAILIAN_REGION=cn-beijing
BAILIAN_WORKSPACE_ID=
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
BAILIAN_WAN_MODEL=wan2.7-t2v

# Commercial voice-over API. This reuses the Beijing Model Studio workspace
# domain and API key above; no second secret is required.
VOICEOVER_PROVIDER=none
BAILIAN_TTS_MODEL=qwen-audio-3.0-tts-plus
BAILIAN_TTS_VOICE=longanlingxin
BAILIAN_TTS_DEFAULT_INSTRUCTION="专业商业广告旁白，像真人自然表达，克制而有感染力；卖点清晰，品牌名和结尾口号适度加重，避免夸张播音腔。"
BAILIAN_TTS_FORMAT=wav
BAILIAN_TTS_SAMPLE_RATE=48000
BAILIAN_TTS_ENABLE_AIGC_TAG=true
BAILIAN_TTS_REQUEST_TIMEOUT_MS=120000

# Volcengine Ark / Doubao Seedance 2.5 direct provider.
# ARK_API_KEY is created in the Ark console and must never be committed.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_SEEDANCE_MODEL=doubao-seedance-2-5-260628
ARK_WATERMARK=false
# Copy current console rates here; leaving blank reports seconds without guessing prices.
COST_WAN_CNY_PER_SECOND=
COST_4K_CNY_PER_SECOND=

# Set in production to require `Authorization: Bearer ...` on every /v1 route.
HARNESS_API_KEY=

# 4K is a separate cloud super-resolution stage, disabled until an OSS master exists.
DELIVERY_MODE=simulation
UPSCALE_PROVIDER=none
ALIYUN_IMS_REGION=cn-beijing
ALIYUN_IMS_ENDPOINT=
ALIYUN_IMS_TEMPLATE_4K=S00000004-401070
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PREFIX=video-agent-harness

# Alternative 4K provider: Volcengine VOD AIGC Standard. These are IAM/VOD
# AK/SK credentials, not the ARK_API_KEY used by Seedance generation.
VOLCENGINE_VOD_ACCESS_KEY_ID=
VOLCENGINE_VOD_SECRET_ACCESS_KEY=
VOLCENGINE_VOD_SESSION_TOKEN=
VOLCENGINE_VOD_SPACE_NAME=
VOLCENGINE_VOD_REGION=cn-north-1
VOLCENGINE_VOD_ENDPOINT=vod.volcengineapi.com
# VOD-managed files are resolved through the public TOS endpoint; no playback domain is required.
VOLCENGINE_TOS_REGION=cn-beijing
VOLCENGINE_TOS_ENDPOINT=tos-cn-beijing.volces.com
# 0 keeps the source look; 1/2 increase repair strength.
VOLCENGINE_VOD_REPAIR_STRENGTH=0
VOLCENGINE_VOD_SOURCE_URL_EXPIRES_SECONDS=7200
VOLCENGINE_VOD_REQUEST_TIMEOUT_MS=15000
VOLCENGINE_VOD_OUTPUT_URL_EXPIRES_SECONDS=3600

# TOS signed output URLs use .volces.com. Add a playback domain only when using the legacy fallback.
MEDIA_IMPORT_ALLOWED_HOST_SUFFIXES=.aliyuncs.com,.volces.com,.volccdn.com,.byteimg.com
MEDIA_IMPORT_MAX_BYTES=2147483648

# IMS uses the Alibaba Cloud credential provider chain. Prefer a least-privilege
# RAM role in production; local development can use these ignored environment values.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Safe bootstrap recipe. `direct + mock` starts without uploads or model charges;
# it is not the product production path. Set `comfyui-libtv` explicitly after
# validating the local workflow and LibTV project.
GENERATION_PIPELINE=direct

# Optional controlled route: local ComfyUI control asset -> LibTV online V2V profile.
# Do not make it the default until a representative final-render A/B proves that
# the control video improves the active model. Keep machine-specific addresses
# in ignored `.env.local` only.
COMFYUI_BASE_URL=
COMFYUI_STUDIO_URL=
COMFYUI_WORKFLOW_PATH=
COMFYUI_POLL_INTERVAL_MS=2000
COMFYUI_TIMEOUT_MS=1800000
LIBTV_CLI_PATH=libtv
LIBTV_PROJECT_UUID=
LIBTV_STUDIO_URL=
LIBTV_MODEL_NAME=Wan 2.7
LIBTV_MODE_TYPE=video2video
LIBTV_MAX_DURATION_SECONDS=10

# Start safely with deterministic planning and the mock direct provider.
VIDEO_PROVIDER=mock
# Optional override. Defaults to 720P for volcengine and 1080P otherwise.
DIRECT_GENERATION_RESOLUTION=
DIRECTOR_MODE=deterministic

# Enable the Pi Director with a separate OpenAI-compatible planning-model key.
DIRECTOR_BASE_URL=
DIRECTOR_API_KEY=
DIRECTOR_MODEL=qwen3.7-plus
