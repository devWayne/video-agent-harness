BAILIAN_REGION=cn-beijing
BAILIAN_WORKSPACE_ID=
BAILIAN_BASE_URL=
BAILIAN_API_KEY=
BAILIAN_WAN_MODEL=wan2.7-t2v
# Copy current console rates here; leaving blank reports seconds without guessing prices.
COST_WAN_CNY_PER_SECOND=
COST_4K_CNY_PER_SECOND=

# Set in production to require `Authorization: Bearer ...` on every /v1 route.
HARNESS_API_KEY=

# 4K is a separate cloud super-resolution stage, disabled until an OSS master exists.
DELIVERY_MODE=simulation
UPSCALE_PROVIDER=none
ALIYUN_IMS_REGION=cn-beijing
ALIYUN_IMS_ENDPOINT=
ALIYUN_IMS_TEMPLATE_4K=S00000004-401070
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_PREFIX=video-agent-harness
MEDIA_IMPORT_ALLOWED_HOST_SUFFIXES=.aliyuncs.com
MEDIA_IMPORT_MAX_BYTES=2147483648

# IMS uses the Alibaba Cloud credential provider chain. Prefer a least-privilege
# RAM role in production; local development can use these ignored environment values.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Start safely with deterministic planning and the mock video provider.
VIDEO_PROVIDER=mock
DIRECTOR_MODE=deterministic

# Enable the Pi Director with a separate OpenAI-compatible planning-model key.
DIRECTOR_BASE_URL=
DIRECTOR_API_KEY=
DIRECTOR_MODEL=qwen3.7-plus
