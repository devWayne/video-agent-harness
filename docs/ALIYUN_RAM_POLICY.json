{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetBucketInfo"
      ],
      "Resource": [
        "acs:oss:*:*:your-video-bucket"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject"
      ],
      "Resource": [
        "acs:oss:*:*:your-video-bucket/video-agent-harness/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ice:ListMediaProducingJobs",
        "ice:SubmitMediaProducingJob",
        "ice:GetMediaProducingJob",
        "ice:ListMediaConvertJobs",
        "ice:SubmitMediaConvertJob",
        "ice:GetMediaConvertJob"
      ],
      "Resource": "*"
    }
  ]
}
