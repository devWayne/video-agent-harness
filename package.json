{
  "name": "video-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented multimodal video agent harness",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:wan": "tsx scripts/smoke-wan.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.5",
    "@alicloud/ice20201109": "6.20.2",
    "@alicloud/openapi-client": "0.4.15",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "ali-oss": "6.23.0",
    "dotenv": "17.2.3",
    "fastify": "5.12.0",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/ali-oss": "6.23.3",
    "@types/node": "^24.10.0",
    "eslint": "10.8.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
