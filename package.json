{
  "name": "video-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented multimodal video agent harness",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:wan": "tsx scripts/smoke-wan.ts",
    "smoke:seedance": "tsx scripts/smoke-seedance.ts",
    "smoke:voiceover": "tsx scripts/smoke-qwen-audio-voiceover.ts",
    "smoke:music": "tsx scripts/smoke-volcengine-music.ts",
    "music:generate": "tsx scripts/smoke-volcengine-music.ts --generate",
    "audio:mix": "tsx scripts/mix-commercial-audio.ts",
    "voiceover:render-manifest": "tsx scripts/render-qwen-audio-voiceover-manifest.ts",
    "smoke:vod-4k": "tsx scripts/smoke-volcengine-vod-4k.ts",
    "vod:upscale-4k": "tsx scripts/upscale-volcengine-vod-4k.ts",
    "smoke:cloud": "tsx scripts/smoke-cloud.ts",
    "skills:install": "node scripts/install-project-skills.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.5",
    "@alicloud/ice20201109": "6.20.2",
    "@alicloud/openapi-client": "0.4.15",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@hyperframes/core": "^0.7.109",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@volcengine/openapi": "1.36.2",
    "@volcengine/tos-sdk": "2.9.1",
    "ali-oss": "6.23.0",
    "dotenv": "17.2.3",
    "fastify": "5.12.0",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/ali-oss": "6.23.3",
    "@types/node": "^24.10.0",
    "eslint": "10.8.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "axios": "1.19.0",
    "protobufjs": "7.6.5",
    "uuid": "11.1.1"
  }
}
