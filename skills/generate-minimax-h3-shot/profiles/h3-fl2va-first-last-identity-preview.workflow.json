{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors",
      "strength_model": 1
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "cpu"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "16": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{HARNESS_FIRST_FRAME}}" }
  },
  "17": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{HARNESS_LAST_FRAME}}" }
  },
  "18": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["16", 0],
      "upscale_method": "area",
      "width": 864,
      "height": 480,
      "crop": "center"
    }
  },
  "19": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["17", 0],
      "upscale_method": "area",
      "width": 864,
      "height": 480,
      "crop": "center"
    }
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "first_frame": ["18", 0],
      "last_frame": ["19", 0],
      "prompt": "{{HARNESS_PROMPT}}",
      "width": 864,
      "height": 480,
      "length": 124
    }
  },
  "7": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": "{{HARNESS_SEED}}" }
  },
  "8": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["2", 0], "conditioning": ["6", 0] }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "10": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["2", 0],
      "scheduler": "simple",
      "steps": 4,
      "denoise": 1
    }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["7", 0],
      "guider": ["8", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["6", 1]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["11", 0], "vae": ["4", 0] }
  },
  "13": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["11", 0], "vae": ["5", 0] }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["12", 0],
      "audio": ["13", 0],
      "fps": 24,
      "bit_depth": 8
    }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["14", 0],
      "filename_prefix": "video-agent-harness/{{HARNESS_CLIENT_REQUEST_ID}}",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
